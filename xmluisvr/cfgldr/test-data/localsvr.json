					"column_types": [],
					"params": []
				}
			]
		}
	},
	"database": {
		"$schema": "https://xmlui.org/schemas/v1/localsvr/db/sqlite3-schema.json",
		"version": 1,
		"type": "sqlite3",
		"filepath": "./data.db",
		"on_open_sql": [],
		"busy_timeout": 0,
		"journal_mode": "",
		"synchronous": "",
		"foreign_keys": "",
		"wal_autocheckpoint": 0,
		"access_mode": 0
	}
}